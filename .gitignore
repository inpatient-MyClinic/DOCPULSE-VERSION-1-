# Never commit the database, the uploaded workbooks, or your secrets.
# The database holds your schedule history; losing or leaking it is the one
# thing this repo cannot help you recover from.
data/
*.db
*.db-wal
*.db-shm
.env
node_modules/
npm-debug.log*

# The test workbooks hold real staff names and schedules: kept out while the
# repository is public. Test output is scratch.
tests/fixtures/
tests/.out/
