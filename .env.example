# Copy to .env and fill in. Never commit .env.

# Signs the login cookies. Any long random string; changing it logs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Where the database and the uploaded workbooks live. On a platform such as
# Railway or Render this MUST point at a mounted persistent volume, or your
# data is erased on every deploy.
DATA_DIR=./data

PORT=3000

# Who may reach the portal at all. Comma-separated IPv4/IPv6 addresses or CIDR
# ranges. Leave EMPTY to allow any address — do that only while testing.
#   ALLOW_IPS=203.0.113.4,203.0.113.0/24,2001:db8::/32
ALLOW_IPS=

# Set to 1 when the app sits behind a reverse proxy or a platform load balancer
# (Railway, Render, Nginx, Cloudflare), so the real client IP is read from the
# X-Forwarded-For header instead of the proxy's own address.
TRUST_PROXY=0

# Cookies are marked Secure unless this is 1. Only set it for local http://.
INSECURE_COOKIES=0

# The first administrator, for a platform where there is no terminal to run
# `npm run adduser` in. Created once, and only while no accounts exist at all.
# Sign in, change the password, then DELETE these two: a password set here has
# been visible in your platform's dashboard.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# A forgotten password, where there is no terminal to run a reset in. Setting a
# password alone never overwrites an existing account; this has to be set too.
# Set ADMIN_EMAIL, ADMIN_PASSWORD and this to 1, restart, then DELETE all three.
ADMIN_RESET=
